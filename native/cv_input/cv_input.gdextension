[configuration]
entry_symbol = "cv_input_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../native/cv_input/bin/libcv_input.linux.debug.x86_64.so"
linux.release.x86_64 = "res://../native/cv_input/bin/libcv_input.linux.release.x86_64.so"
windows.debug.x86_64 = "res://../native/cv_input/bin/cv_input.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://../native/cv_input/bin/cv_input.windows.release.x86_64.dll"

[dependencies]
linux.debug.x86_64 = {}
linux.release.x86_64 = {}
windows.debug.x86_64 = {}
windows.release.x86_64 = {}
